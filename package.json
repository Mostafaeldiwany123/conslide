{
  "name": "pro-layout-addin",
  "version": "1.0.0",
  "description": "Production-Ready PowerPoint Add-in — Professional Layout Automation",
  "main": "src/index.jsx",
  "scripts": {
    "start": "webpack serve --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "dev": "webpack serve --config webpack.config.js --mode development --open",
    "start:desktop": "office-addin-debugging start manifest.xml desktop",
    "stop:desktop": "office-addin-debugging stop manifest.xml",
    "lint": "eslint src/",
    "validate": "npx office-addin-manifest validate manifest.xml"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.225",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "fuse.js": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "office-addin-debugging": "^5.0.0",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.5",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "keywords": [
    "powerpoint",
    "addin",
    "office-js",
    "layout",
    "react"
  ],
  "author": "Pro Layout Team",
  "license": "MIT"
}